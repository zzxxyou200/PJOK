# Copy to .env and adjust for your environment
PORT=8080
DB_URL=jdbc:mysql://localhost:6787/Cust_detail
DB_USERNAME=admin
DB_PASSWORD=123
# For Neon, replace the three DB_* values above:
# DB_URL=jdbc:postgresql://ep-red-fire-aok36dly-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=<set locally; never commit>
JWT_SECRET=change-me-to-a-random-secret-at-least-256-bits-long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000